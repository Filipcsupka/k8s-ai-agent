# Ollama endpoint — local dev: Tailscale IP, in-cluster: service DNS
OLLAMA_BASE_URL=http://100.86.152.16:11434
OLLAMA_MODEL=qwen3:8b

# Slack incoming webhook URL (optional — logs to stdout if empty)
SLACK_WEBHOOK_URL=

# kubeconfig path — only needed for local dev (in-cluster auth is automatic)
KUBECONFIG=/Users/filipcsupka/moje/infra/kubeconfig.yaml

# Phase 2+: ChromaDB for runbook RAG
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Approval gate (Phase 3) — set to "true" to allow agent to apply fixes after Slack approval
ENABLE_AUTO_APPLY=false
